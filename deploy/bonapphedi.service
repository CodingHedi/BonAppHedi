[Unit]
Description=Bon App' Hedi
Documentation=https://github.com/CodingHedi/BonAppHedi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bonapphedi
Group=bonapphedi

# Credentials only. The jar deliberately contains none - that is enforced in the
# build - so this file is the single place they exist on the machine.
EnvironmentFile=/etc/bonapphedi/bonapphedi.env

WorkingDirectory=/opt/bonapphedi
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=70 -jar /opt/bonapphedi/bonapphedi.jar --spring.profiles.active=prod

# The application handles SIGTERM and finishes in-flight requests, because
# server.shutdown=graceful is set in application-prod.yml. Without the matching
# patience here systemd would kill it mid-request on every deploy.
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=on-failure
RestartSec=5s

# --- sandboxing -------------------------------------------------------------
#
# The service needs to write in exactly two places. Everything else on the disk
# is read-only to it, so a remote-code bug has nowhere to put anything.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/bonapphedi /var/log/bonapphedi

# It talks to nothing but the loopback interface and outbound HTTPS (Google's
# token and userinfo endpoints during a sign-in).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bonapphedi

[Install]
WantedBy=multi-user.target
