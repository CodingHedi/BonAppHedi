[Unit]
Description=Bon App' Hedi
Documentation=https://github.com/CodingHedi/BonAppHedi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bonapphedi
Group=bonapphedi

# Not a secret, and it has to be an environment variable rather than a line in
# application-prod.yml.
#
# BackendApplication.main creates the database's parent directory *before*
# SpringApplication.run, because SQLite will make the file but never the folder
# and Flyway runs too early for a bean to help. That code reads BAH_DB directly
# and has never heard of a profile, so with this unset it falls back to its own
# default of ./data - which resolves against WorkingDirectory below and is
# read-only under ProtectSystem=strict. The service died on exactly that:
#
#   cannot create the database directory at /opt/bonapphedi/./data
#
# application-prod.yml defaults to the same path, so the two agree either way;
# setting it here is what makes the pre-Spring half agree too.
Environment=BAH_DB=/var/lib/bonapphedi/bonapphedi.db

# Credentials only. The jar deliberately contains none - that is enforced in the
# build - so this file is the single place they exist on the machine.
EnvironmentFile=/etc/bonapphedi/bonapphedi.env

WorkingDirectory=/opt/bonapphedi
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=70 -jar /opt/bonapphedi/bonapphedi.jar --spring.profiles.active=prod

# The application handles SIGTERM and finishes in-flight requests, because
# server.shutdown=graceful is set in application-prod.yml. Without the matching
# patience here systemd would kill it mid-request on every deploy.
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=on-failure
RestartSec=5s

# --- sandboxing -------------------------------------------------------------
#
# The service needs to write in exactly two places. Everything else on the disk
# is read-only to it, so a remote-code bug has nowhere to put anything.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/bonapphedi /var/log/bonapphedi

# It talks to nothing but the loopback interface and outbound HTTPS (Google's
# token and userinfo endpoints during a sign-in).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bonapphedi

[Install]
WantedBy=multi-user.target
