[Unit]
Description=Nightly Bon App' Hedi database backup

[Timer]
# 03:20 rather than 03:00: everything on the internet runs at the top of the
# hour, and a VPS is sharing its disk with neighbours doing the same.
OnCalendar=*-*-* 03:20:00
# Runs on the next boot if the machine was off at 03:20 — a VPS that was
# rebooted overnight should not silently skip a day.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
