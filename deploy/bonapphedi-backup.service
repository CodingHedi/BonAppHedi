[Unit]
Description=Back up the Bon App' Hedi database
Documentation=file:/usr/local/bin/bonapphedi-backup

[Service]
Type=oneshot
# Root, because it reads the service's data directory and writes to
# /var/backups, and because a backup that can be tampered with by the process
# it is backing up is not much of a backup.
User=root
ExecStart=/usr/local/bin/bonapphedi-backup
