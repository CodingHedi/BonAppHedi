# Caddy in front of the fat jar. Installed to /etc/caddy/Caddyfile by
# deploy/provision.sh - edit it here and re-run that, so the repository stays
# the source of truth rather than the server.
#
# Caddy gets and renews the certificate itself over ACME. Nothing here mentions
# a certificate path for that reason, and nothing needs a cron job.

bonapphedi.fr {
	encode zstd gzip

	# The application binds 127.0.0.1 (application-prod.yml), so this is the
	# only route in. Caddy sets X-Forwarded-Proto and X-Forwarded-Host, which
	# Spring reads because of server.forward-headers-strategy=framework -
	# without that pair every OAuth redirect comes back as http:// and sign-in
	# fails in a way that looks like Google's fault.
	reverse_proxy 127.0.0.1:8080

	header {
		# Once this is on, browsers refuse plain http for the domain for a
		# year. Correct here and worth being deliberate about: it is awkward
		# to undo, because browsers remember it.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Stops a browser second-guessing a declared Content-Type, which is
		# how an uploaded file gets treated as script.
		X-Content-Type-Options "nosniff"

		# No framing: the site is never embedded, and this is the cheap half
		# of clickjacking protection.
		X-Frame-Options "DENY"

		# Send the origin to other sites, never the full path. A recipe URL is
		# not secret; the habit is.
		Referrer-Policy "strict-origin-when-cross-origin"

		# Nothing here uses a camera, a microphone or a location.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

		# Content-Security-Policy, arrived at by testing it against the running
		# application rather than by reasoning about it. Every term below is
		# here because removing it broke something specific, and the first
		# attempt at this - deployed straight to production without that testing
		# - took the site down.
		#
		# script-src
		#   'sha256-...'   the one inline script in index.html: the anti-FOUC theme
		#                bootstrap. Hashed rather than 'unsafe-inline', and
		#                deploy.ps1 refuses to ship if the script changes and the
		#                hash goes stale.
		#   'unsafe-eval' transloco-messageformat compiles ICU plurals with
		#                new Function. Without it `{count, plural, ...}` renders
		#                empty - the recipe count and the comment heading both
		#                vanish. Removing the dependency would remove this; see
		#                Docs/backlog.md.
		#   youtube.com  the video facade loads the IFrame Player API script on
		#                click. Nothing is fetched from Google until then, which
		#                is what ADR 6 is about - the facade is the consent.
		#
		# style-src needs 'unsafe-inline' and there is no way around it in
		# Angular: runtime style bindings are how the avatar tints and the image
		# placeholders get their hue.
		#
		# frame-src carries both hosts: the player iframe is youtube-nocookie,
		# the API script's own frames are youtube.com.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-JC8YccYQVdSh9R3jSxk4CHhlXnmoZup7ymWUhGZQO9g=' 'unsafe-eval' https://www.youtube.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

		# Caddy announces itself by default.
		-Server
	}

	# Hashed filenames, so these can be cached hard. index.html deliberately is
	# not in this list: it is the one file that must be re-fetched, or a deploy
	# leaves browsers loading last week's bundle names.
	@immutable path *.js *.css *.woff2 *.woff *.svg *.png *.jpg *.webp *.avif *.ico
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Access logs go to journald, which is Caddy's default and is where
	# DEPLOY.md already sends you: journalctl -u caddy.
	#
	# There was a `log { output file ... }` block here and it broke the service.
	# provision.sh runs `caddy validate` as root, validate opens the log file,
	# and the file was therefore created root:root 0600 - after which the caddy
	# user could not write to it and the unit died at startup with "permission
	# denied" on a directory it plainly owns. Fixable by chowning after every
	# validate; not worth a file nobody was going to read separately.
}

# One canonical hostname. Both are in DNS, and without this the site would exist
# twice as far as search engines are concerned.
www.bonapphedi.fr {
	redir https://bonapphedi.fr{uri} permanent
}

# The Content-Security-Policy is on the site block above. It was developed
# against a local `java -jar` with the header injected by Playwright, iterating
# until the console was clean, and only then deployed - which is the method to
# repeat if it ever needs changing. The harness is described in DEPLOY.md.
