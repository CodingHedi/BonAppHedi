{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test smoke",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "check:legal": "node ../scripts/check-legal.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "verify:prod": "npm run check:legal && npm run lint && npm run typecheck && npm run test && npm run build && cross-env PW_TARGET=prod playwright test"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/youtube-player": "^22.0.6",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "angular-eslint": "22.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "oauth2-mock-server": "9.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
