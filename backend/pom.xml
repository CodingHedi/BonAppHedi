<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>fr.bonapphedi</groupId>
  <artifactId>backend</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>Bon App' Hedi API</name>
  <description>Recipe notebook API</description>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      SQLite JDBC. Foreign keys are OFF by default in SQLite and are enabled
      through the JDBC URL, not here - see ADR 0002. Without that every
      ON DELETE CASCADE in the schema is inert.
    -->
    <sqlite.version>3.50.3.0</sqlite.version>
    <commonmark.version>0.29.0</commonmark.version>
    <owasp.sanitizer.version>20260313.1</owasp.sanitizer.version>
    <!--
      Where `ng build` leaves the application. Angular writes a `browser`
      subdirectory under the project's outputPath; the jar wants its contents at
      the root of static/, not the directory itself.
    -->
    <angular.dist>${project.basedir}/../frontend/dist/frontend/browser</angular.dist>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      Spring Data JDBC rather than JPA. Hibernate's SQLite support is
      community-maintained and its DDL generation emits statements SQLite
      rejects; the aggregate-root semantics here also match the domain exactly,
      where saving a recipe means replacing its ingredients and steps wholesale.
      ADR 0002.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      Session cookies rather than JWT (ADR 0003). The frontend and the API are
      same-origin in every environment, so there is nothing to gain from putting
      a bearer token where XSS can read it, and a session can genuinely be
      revoked on logout.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>

    <!--
      Sessions live in SQLite next to everything else, so a restart does not sign
      everyone out and the deployment stays a single file. Spring Session ships
      DDL for nine databases and SQLite is not among them, so the tables are
      created by Flyway in V3 and the built-in initializer is switched off.
    -->
    <dependency>
      <groupId>org.springframework.session</groupId>
      <artifactId>spring-session-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.version}</version>
    </dependency>

    <!--
      Markdown is rendered and sanitized once, on write, so the database only
      ever holds HTML that is already safe. The reason is not the read-time
      saving the contract mentions - at this size that is nothing - it is that a
      comment body is untrusted input from a stranger, and neutralising it at
      the boundary beats trusting every client to do it on the way out.

      commonmark rather than flexmark: this app uses a narrow markdown subset,
      commonmark carries no transitive dependencies, and it tracks the same spec
      as `marked`, which the frontend still uses for its live previews. Two
      renderers that disagree would mean stored and previewed content looking
      different.
    -->
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark</artifactId>
      <version>${commonmark.version}</version>
    </dependency>
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark-ext-gfm-tables</artifactId>
      <version>${commonmark.version}</version>
    </dependency>
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark-ext-gfm-strikethrough</artifactId>
      <version>${commonmark.version}</version>
    </dependency>

    <!--
      Policy-based, so the allowlist can mirror the DOMPurify configuration in
      the frontend's markdown component exactly rather than approximately.
    -->
    <dependency>
      <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
      <artifactId>owasp-java-html-sanitizer</artifactId>
      <version>${owasp.sanitizer.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Not part of spring-boot-starter-test. Supplies the request post-processors
      that stand a signed-in OAuth2 principal up in front of MockMvc, which is
      the only way to assert the authenticated paths without a live Google.
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The deployable artefact: one jar with the Angular build inside it, served
      by SpaResourceConfig. Off by default, so `mvnw test` and
      `mvnw spring-boot:run` stay a backend-only concern and need no Node.

      This copies a build rather than running one. The alternative,
      frontend-maven-plugin, would download its own Node and invoke npm from
      Maven — which sounds tidier and is worse here: it silently builds the
      frontend with a Node other than the one .nvmrc pins, and it hides the
      Angular output behind Maven logging at the moment you most want to read
      it. `npm run verify:prod` is already the gate before a deploy (README),
      and it has produced dist/ by the time this runs.

      If dist/ is missing the build fails with a message saying so, rather than
      producing a jar that answers every page with a 404 — which is what an
      empty static/ directory would do, and it would not be noticed until the
      thing was running on the server.
    -->
    <profile>
      <id>web</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>copy-angular-build</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${angular.dist}</directory>
                      <!-- Hashed bundles and images must not be filtered: Maven
                           would try to interpolate ${...} inside them. -->
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!--
            The guard checks what landed in the jar rather than what was on disk
            beforehand, which is both the stronger question and the one that can
            be asked with an absolute path. Pointed at frontend/dist it has to
            reach through `..`, and the enforcer does not resolve that — it
            reports a file as missing while the file is plainly there, which
            cost a confused ten minutes.

            Bound to prepare-package so it runs after the copy above.
          -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>the-jar-must-contain-the-app</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireFilesExist>
                      <files>
                        <file>${project.build.outputDirectory}/static/index.html</file>
                      </files>
                      <message>
                        No index.html in the jar's static/. Run `npm run build` (or the whole
                        `npm run verify:prod`) in frontend/ before packaging with -Pweb —
                        otherwise this produces a jar that answers every page with a 404, and
                        nothing says so until it is running on the server.
                      </message>
                    </requireFilesExist>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
